# App (required in production — used by email templates and metadataBase)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security — required. Booking webhook tokens are HMAC-signed with this secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production code throws if this is missing (see src/lib/services/security.ts).
WEBHOOK_SECRET=generate-64-hex-chars-with-crypto-randomBytes-32
